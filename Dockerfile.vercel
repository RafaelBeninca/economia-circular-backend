# CAMADA: Empacotamento
# RESPONSABILIDADE: compilar e executar a API com Java 25 isolado do Java do host.
# REGRAS: o banco é externo; nenhuma configuração local ou segredo entra na imagem.
# SITUAÇÃO: imagem HTTP usada tanto na validação local quanto no Container Runtime.
FROM maven:3.9.12-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -ntp package

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/target/*.jar ./app.jar
# Configure PORT=8080 também no projeto Vercel, para o roteamento do container.
ENV PORT=8080
EXPOSE 8080
# O processo não precisa de privilégios de administrador para servir em 8080.
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
